      }
      div.buttons {
        margin-top: 30px;
        text-align: right;
      }
      h3 {
        margin: 36px 0;
        font-size: 16pt;
      }
      .blocked      h3 {
        color: #c00;
      }
      .authenticate h3 {
        color: #36c;
      }
      h2.fgd_icon {
        background: url(data:image/png;base64,) 0 0px repeat-x;
        width: 120px;
        height: 92px;
        margin: 48px auto;
      }
      .blocked      h2.fgd_icon {
        background-position: 0 -166px;
      }
      .authenticate h2.fgd_icon {
        background-position: -89px -166px;
      }
      form {
        width: 300px;
        margin: 30px 0;
      }
      label {
        display: block;
        width: 300px;
        margin: 5px 0;
        line-height: 25px;
      }
      label input {
        width: 200px;
        border: 1px solid #7f9db9;
        height: 20px;
        float: right;
      }
    </style>
    <title>
      The URL you requested has been blocked 
    </title>
  </head>
  <body class="block">
